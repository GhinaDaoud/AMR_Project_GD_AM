amcl:
  ros__parameters:
    # --- Time & Frames ---
    use_sim_time: true       # Use Gazebo's clock instead of your system clock
    global_frame_id: map     # The coordinate system of the static map
    odom_frame_id: odom      # The local coordinate system (robot's start point)
    base_frame_id: base_link # The physical center of your robot
    scan_topic: /scan        # The incoming LiDAR data topic

    # --- Particle Filter Size ---
    min_particles: 200       # Minimum number of "guesses" (particles) to maintain
    max_particles: 1000      # More particles = higher accuracy but higher CPU usage

    # --- Odometry Noise Model (The "Alpha" parameters) ---
    # These represent how much your robot's wheels slip or drift.
    alpha1: 0.2              # Noise in rotation from rotation
    alpha2: 0.2              # Noise in rotation from translation
    alpha3: 0.2              # Noise in translation from translation
    alpha4: 0.2              # Noise in translation from rotation
    alpha5: 0.2              # Only used for Omni-directional robots

    # --- Laser Sensor Model ---
    # These define how much you trust the LiDAR compared to the map.
    z_hit: 0.5               # Probability of the beam hitting a known obstacle
    z_short: 0.05            # Probability of "short" hits (e.g., a person walking by)
    z_max: 0.05              # Probability of the beam hitting nothing (out of range)
    z_rand: 0.5              # Probability of complete random noise/interference
    sigma_hit: 0.2           # Standard deviation of the "hit" noise
    lambda_short: 0.1        # Exponential decay parameter for short readings

    # --- Sensor Processing ---
    laser_model_type: likelihood_field # 'likelihood_field' is faster than 'beam'
    max_beams: 60            # How many laser beams to use for the calculation (skip beams to save CPU)

    # --- Update Triggers ---
    # AMCL doesn't calculate constantly; it waits for the robot to move.
    update_min_d: 0.20       # Update particles after moving 0.2 meters
    update_min_a: 0.20       # Update particles after rotating ~11 degrees (0.2 radians)

    # --- Performance & Recovery ---
    resample_interval: 1     # How many filter updates between resampling particles
    transform_tolerance: 1.0 # Seconds to wait before a TF expires (prevents stutter)
    recovery_alpha_slow: 0.0 # Used for "Kidnapped Robot" recovery (detecting bad localization)
    recovery_alpha_fast: 0.0 # Used for fast recovery from sudden pose jumps

map_server:
  ros__parameters:
    use_sim_time: true
    yaml_filename: ""        # This is usually set in the Launch file, not here

lifecycle_manager_localization:
  ros__parameters:
    use_sim_time: true
    autostart: true          # Automatically transitions nodes to 'Active' state
    node_names:              # List of nodes this manager controls
      - map_server
      - amcl
