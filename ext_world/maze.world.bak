<?xml version="1.0" ?>
<sdf version='1.8'>
  <world name='maze'>

    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Ground plane -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== OUTER BOUNDARY WALLS (20x20m arena) ===== -->
    <!-- North wall -->
    <model name='wall_north'><static>true</static><link name='link'>
      <pose>0 10 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>20 0.2 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>20 0.2 2</size></box></geometry>
        <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material></visual>
    </link></model>

    <!-- South wall -->
    <model name='wall_south'><static>true</static><link name='link'>
      <pose>0 -10 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>20 0.2 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>20 0.2 2</size></box></geometry>
        <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material></visual>
    </link></model>

    <!-- East wall -->
    <model name='wall_east'><static>true</static><link name='link'>
      <pose>10 0 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 20 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 20 2</size></box></geometry>
        <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material></visual>
    </link></model>

    <!-- West wall -->
    <model name='wall_west'><static>true</static><link name='link'>
      <pose>-10 0 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 20 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 20 2</size></box></geometry>
        <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material></visual>
    </link></model>

    <!-- ===== INTERIOR WALLS — ROOM DIVIDERS ===== -->

    <!-- Horizontal divider: splits arena into top/bottom halves, gap on right -->
    <model name='h_div_left'><static>true</static><link name='link'>
      <pose>-2.5 0 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>15 0.2 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>15 0.2 2</size></box></geometry>
        <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material></visual>
    </link></model>

    <!-- Vertical divider: left side corridor — split with 1.5 m opening at y=1.5..3 -->
    <model name='v_div_left_lower'><static>true</static><link name='link'>
      <pose>-5 0.25 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 2.5 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 2.5 2</size></box></geometry>
        <material><ambient>0.3 0.6 0.4 1</ambient><diffuse>0.3 0.6 0.4 1</diffuse></material></visual>
    </link></model>
    <model name='v_div_left_upper'><static>true</static><link name='link'>
      <pose>-5 6.5 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 7 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 7 2</size></box></geometry>
        <material><ambient>0.3 0.6 0.4 1</ambient><diffuse>0.3 0.6 0.4 1</diffuse></material></visual>
    </link></model>

    <!-- Vertical divider: right side, top half — 2.5 m opening at y=3.5..6 (centre of wall) -->
    <model name='v_div_right_top_lower'><static>true</static><link name='link'>
      <pose>3 2.25 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 2.5 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 2.5 2</size></box></geometry>
        <material><ambient>0.3 0.6 0.4 1</ambient><diffuse>0.3 0.6 0.4 1</diffuse></material></visual>
    </link></model>
    <model name='v_div_right_top_upper'><static>true</static><link name='link'>
      <pose>3 8 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 4 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 4 2</size></box></geometry>
        <material><ambient>0.3 0.6 0.4 1</ambient><diffuse>0.3 0.6 0.4 1</diffuse></material></visual>
    </link></model>

    <!-- Bottom-right room: vertical wall — split with 2 m opening at y=-6..-4 -->
    <model name='br_wall_v_lower'><static>true</static><link name='link'>
      <pose>3 -8 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 4 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 4 2</size></box></geometry>
        <material><ambient>0.5 0.5 0.3 1</ambient><diffuse>0.5 0.5 0.3 1</diffuse></material></visual>
    </link></model>
    <model name='br_wall_v_upper'><static>true</static><link name='link'>
      <pose>3 -2.5 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>0.2 3 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 3 2</size></box></geometry>
        <material><ambient>0.5 0.5 0.3 1</ambient><diffuse>0.5 0.5 0.3 1</diffuse></material></visual>
    </link></model>

    <!-- Bottom-right room: horizontal wall, gap on left -->
    <model name='br_wall_h'><static>true</static><link name='link'>
      <pose>6.5 -3 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>7 0.2 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>7 0.2 2</size></box></geometry>
        <material><ambient>0.5 0.5 0.3 1</ambient><diffuse>0.5 0.5 0.3 1</diffuse></material></visual>
    </link></model>

    <!-- Narrow corridor: top-left box (reduced size) — QR Zone-A -->
    <model name='tl_box'><static>true</static><link name='link'>
      <pose>-7.5 6 0.75 0 0 0</pose>
      <collision name='c'><geometry><box><size>1.5 1.5 1.5</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.5 1.5 1.5</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>file://qr_textures/qr_tl_box.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
    </link></model>

    <!-- Central pillar cluster — QR Zone-B / Zone-C -->
    <model name='pillar_a'><static>true</static><link name='link'>
      <pose>0 3 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>1.5 1.5 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.5 1.5 2</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>file://qr_textures/qr_pillar_a.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
    </link></model>

    <model name='pillar_b'><static>true</static><link name='link'>
      <pose>0 -4 1 0 0 0</pose>
      <collision name='c'><geometry><box><size>1.5 1.5 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.5 1.5 2</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>file://qr_textures/qr_pillar_b.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
    </link></model>

    <!-- Diagonal obstacle block (top-right area) — QR Zone-D -->
    <model name='diag_block_1'><static>true</static><link name='link'>
      <pose>6 6 1 0 0 0.785</pose>
      <collision name='c'><geometry><box><size>3 0.3 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>3 0.3 2</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>file://qr_textures/qr_diag_block_1.png</albedo_map>
          </metal></pbr>
        </material>
      </visual>
    </link></model>

    <model name='diag_block_2'><static>true</static><link name='link'>
      <pose>7.5 4.5 1 0 0 0.785</pose>
      <collision name='c'><geometry><box><size>3 0.3 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>3 0.3 2</size></box></geometry>
        <material><ambient>0.3 0.3 0.7 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material></visual>
    </link></model>

    <!-- ===== CYLINDER OBSTACLES (varied sizes) ===== -->
    <!-- Small — tight corridor near central junction -->
    <model name='obs_cyl_1'><static>true</static><link name='link'>
      <pose>1.5 2 0.4 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Medium — open central area -->
    <model name='obs_cyl_2'><static>true</static><link name='link'>
      <pose>-2 -3 0.6 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Small-medium — bottom-left open room -->
    <model name='obs_cyl_3'><static>true</static><link name='link'>
      <pose>-7 -6 0.5 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.22</radius><length>1.0</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Large — wide bottom-right room has plenty of space -->
    <model name='obs_cyl_4'><static>true</static><link name='link'>
      <pose>7 -7 0.85 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.4</radius><length>1.7</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.4</radius><length>1.7</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Medium-large — open top area above h_div -->
    <model name='obs_cyl_5'><static>true</static><link name='link'>
      <pose>-3 7.5 0.75 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Medium — bottom-right room, second obstacle -->
    <model name='obs_cyl_6'><static>true</static><link name='link'>
      <pose>6 -5 0.5 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Small — inside top-right room, away from the opening -->
    <model name='obs_cyl_7'><static>true</static><link name='link'>
      <pose>6.5 7 0.45 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.18</radius><length>0.9</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.18</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

    <!-- Large — spacious bottom-left open area -->
    <model name='obs_cyl_8'><static>true</static><link name='link'>
      <pose>-7.5 -4 0.9 0 0 0</pose>
      <collision name='c'><geometry><cylinder><radius>0.45</radius><length>1.8</length></cylinder></geometry></collision>
      <visual name='v'><geometry><cylinder><radius>0.45</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
    </link></model>

  </world>
</sdf>
