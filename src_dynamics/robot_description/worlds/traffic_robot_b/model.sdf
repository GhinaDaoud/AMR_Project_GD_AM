<?xml version="1.0" ?>
<!--
  traffic_robot_b — green box traffic robot
  Instance name : traffic_robot_2  (set by <include><name> in maze.sdf)
  Spawn pose    : (-3, 5, 0) in maze world
  Topics        : /traffic_robot_2/cmd_vel  (ROS → Gazebo)
                  /traffic_robot_2/scan     (Gazebo → ROS)

  Geometry (all in model frame = world frame at spawn, origin = ground)
    base_link    box 0.45×0.35×0.16   centre z=0.15   (top z=0.23)
    beacon_link  box 0.10×0.10×0.24   centre z=0.35   (spans z=0.23→0.47)
                   ↑ extends above LIDAR plane so other robots can see it
    left_wheel   cylinder r=0.07 w=0.04  centre (-0.02,  0.195, 0.07)
    right_wheel  cylinder r=0.07 w=0.04  centre (-0.02, -0.195, 0.07)
    front_caster sphere r=0.035          centre ( 0.17,  0.00, 0.035)
    rear_caster  sphere r=0.035          centre (-0.17,  0.00, 0.035)
    lidar_link                           centre ( 0.00,  0.00, 0.24)
                   ↑ scans at z=0.24 → intersects beacon band [0.23, 0.47]

  DiffDrive wheel_separation = 0.39
-->
<sdf version="1.10">
<model name="traffic_robot_b">

  <!-- ── chassis ──────────────────────────────────────────────────── -->
  <link name="base_link">
    <pose>0 0 0.15 0 0 0</pose>
    <inertial>
      <mass>6.0</mass>
      <inertia>
        <ixx>0.074</ixx><iyy>0.114</iyy><izz>0.163</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><box><size>0.45 0.35 0.16</size></box></geometry>
    </collision>
    <visual name="vis">
      <geometry><box><size>0.45 0.35 0.16</size></box></geometry>
      <material>
        <ambient>0.10 0.72 0.20 1</ambient>
        <diffuse>0.10 0.72 0.20 1</diffuse>
      </material>
    </visual>
  </link>

  <!-- ── beacon tower (LIDAR target for other robots) ─────────────── -->
  <!-- Spans z=0.23 to z=0.47 so horizontal LIDAR scans at z=0.24
       hit this beacon. Gazebo ignores self-model hits. -->
  <link name="beacon_link">
    <pose>0 0 0.35 0 0 0</pose>
    <inertial>
      <mass>0.2</mass>
      <inertia>
        <ixx>0.00113</ixx><iyy>0.00113</iyy><izz>0.00033</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><box><size>0.10 0.10 0.24</size></box></geometry>
    </collision>
  </link>

  <joint name="beacon_joint" type="fixed">
    <parent>base_link</parent><child>beacon_link</child>
  </joint>

  <!-- ── left wheel ───────────────────────────────────────────────── -->
  <link name="left_wheel">
    <pose>-0.02 0.195 0.07 1.5707963 0 0</pose>
    <inertial>
      <mass>0.5</mass>
      <inertia>
        <ixx>0.00068</ixx><iyy>0.00068</iyy><izz>0.00123</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>0.5</mu2></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="revolute">
    <parent>base_link</parent><child>left_wheel</child>
    <axis>
      <xyz expressed_in="__model__">0 1 0</xyz>
      <limit><lower>-1e308</lower><upper>1e308</upper></limit>
    </axis>
  </joint>

  <!-- ── right wheel ──────────────────────────────────────────────── -->
  <link name="right_wheel">
    <pose>-0.02 -0.195 0.07 1.5707963 0 0</pose>
    <inertial>
      <mass>0.5</mass>
      <inertia>
        <ixx>0.00068</ixx><iyy>0.00068</iyy><izz>0.00123</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>0.5</mu2></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="revolute">
    <parent>base_link</parent><child>right_wheel</child>
    <axis>
      <xyz expressed_in="__model__">0 1 0</xyz>
      <limit><lower>-1e308</lower><upper>1e308</upper></limit>
    </axis>
  </joint>

  <!-- ── front caster ─────────────────────────────────────────────── -->
  <link name="front_caster">
    <pose>0.17 0 0.035 0 0 0</pose>
    <inertial>
      <mass>0.1</mass>
      <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
               <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
    </inertial>
    <collision name="col">
      <geometry><sphere><radius>0.035</radius></sphere></geometry>
      <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><sphere><radius>0.035</radius></sphere></geometry>
      <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
    </visual>
  </link>

  <joint name="front_caster_joint" type="ball">
    <parent>base_link</parent><child>front_caster</child>
  </joint>

  <!-- ── rear caster ──────────────────────────────────────────────── -->
  <link name="rear_caster">
    <pose>-0.17 0 0.035 0 0 0</pose>
    <inertial>
      <mass>0.1</mass>
      <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
               <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
    </inertial>
    <collision name="col">
      <geometry><sphere><radius>0.035</radius></sphere></geometry>
      <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
    </collision>
    <visual name="vis">
      <geometry><sphere><radius>0.035</radius></sphere></geometry>
      <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
    </visual>
  </link>

  <joint name="rear_caster_joint" type="ball">
    <parent>base_link</parent><child>rear_caster</child>
  </joint>

  <!-- ── LIDAR (scans at z=0.24, inside other robots' beacon band) ── -->
  <link name="lidar_link">
    <pose>0 0 0.24 0 0 0</pose>
    <sensor name="lidar" type="gpu_lidar">
      <topic>/traffic_robot_2/scan</topic>
      <gz_frame_id>traffic_robot_2/lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.15</min><max>8.0</max><resolution>0.02</resolution></range>
      </lidar>
      <always_on>true</always_on><visualize>false</visualize>
    </sensor>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent>base_link</parent><child>lidar_link</child>
  </joint>

  <!-- ── differential drive ───────────────────────────────────────── -->
  <plugin filename="gz-sim-diff-drive-system"
          name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.39</wheel_separation>
    <wheel_radius>0.07</wheel_radius>
    <topic>/traffic_robot_2/cmd_vel</topic>
    <odom_topic>/traffic_robot_2/odom</odom_topic>
    <tf_topic>/traffic_robot_2/tf</tf_topic>
    <frame_id>traffic_robot_2/odom</frame_id>
    <child_frame_id>traffic_robot_2/base_link</child_frame_id>
    <max_linear_acceleration>1.0</max_linear_acceleration>
    <max_angular_acceleration>2.0</max_angular_acceleration>
  </plugin>

</model>
</sdf>
