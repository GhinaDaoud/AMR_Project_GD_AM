<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="pharmacy">
    <static>true</static>
    <link name="link">
      <!-- GLB has Y-up rotation and 0.01 scale baked into node matrix — no SDF rotation needed -->
      <pose>0 0 0 1.5708 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://pharmacy/meshes/model.glb</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://pharmacy/meshes/model.glb</uri>
            <scale>0.65 0.65 0.65</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
