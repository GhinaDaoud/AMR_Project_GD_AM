<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="small_japanese_house">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <!-- Put your .glb file at models/small_japanese_house/meshes/model.glb -->
            <uri>model://small_japanese_house/meshes/model.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://small_japanese_house/meshes/model.glb</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>