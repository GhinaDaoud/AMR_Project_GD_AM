<?xml version="1.0" ?>
<!-- Simple tree: brown trunk cylinder + green foliage sphere. Origin at ground level -->
<sdf version="1.6">
  <model name="tree">
    <static>true</static>
    <link name="link">

      <!-- Trunk collision -->
      <collision name="col_trunk">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>2.4</length></cylinder></geometry>
      </collision>

      <!-- Foliage collision (sphere approximation) -->
      <collision name="col_foliage">
        <pose>0 0 3.4 0 0 0</pose>
        <geometry><sphere><radius>1.25</radius></sphere></geometry>
      </collision>

      <!-- Trunk -->
      <visual name="trunk">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>2.4</length></cylinder></geometry>
        <material>
          <ambient>0.32 0.18 0.04 1</ambient>
          <diffuse>0.32 0.18 0.04 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Foliage -->
      <visual name="foliage">
        <pose>0 0 3.4 0 0 0</pose>
        <geometry><sphere><radius>1.25</radius></sphere></geometry>
        <material>
          <ambient>0.10 0.48 0.08 1</ambient>
          <diffuse>0.10 0.48 0.08 1</diffuse>
          <specular>0.05 0.1 0.05 1</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>
