<?xml version="1.0" ?>
<!--
  Mixed Town World  (v2.1)
  · East wall:  X=22 → X=20  (2 m inward)
  · South wall: Y=-22 → Y=-18 (4 m inward)
  · North / West walls unchanged (Y=22, X=-22)
  · 4 trees added at docking-station corners; rest redistributed to empty areas

  Axes: X+ = East, Y+ = North.  Origin = docking station center.
  LAUNCH:  bash launch_gazebo.sh
-->
<sdf version="1.6">
  <world name="mixed_town_v2">

    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
      <ambient>0.70 0.70 0.70 1</ambient>
      <background>0.55 0.82 0.94 1</background>
      <shadows>false</shadows>
    </scene>
    <include><uri>model://sun</uri></include>

    <!-- WHITE GROUND WITH GRID  40 x 40 m, centred at (2, 2) — X[-18,+22] Y[-18,+22] -->
    <model name="grey_ground">
      <static>true</static>
      <pose>2 2 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>40 40 0.1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>40 40 0.1</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!--  BORDER WALLS  X[-18,+20]  Y[-18,+22]                      -->
    <!--  West moved from -22 → -18 (flush with pharmacy/firestation) -->
    <!--  N/S walls span 36 m (centre X=2)                           -->
    <!--  E/W walls span 40 m (centre Y=2)                           -->
    <!-- ============================================================ -->
    <model name="wall_north">
      <static>true</static><pose>1 22 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>38.4 0.4 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>38.4 0.4 2</size></box></geometry>
          <material><ambient>0.75 0.70 0.60 1</ambient><diffuse>0.75 0.70 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>1 -18 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>38.4 0.4 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>38.4 0.4 2</size></box></geometry>
          <material><ambient>0.75 0.70 0.60 1</ambient><diffuse>0.75 0.70 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>20 2 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 40.4 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 40.4 2</size></box></geometry>
          <material><ambient>0.75 0.70 0.60 1</ambient><diffuse>0.75 0.70 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-18 2 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 40.4 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 40.4 2</size></box></geometry>
          <material><ambient>0.75 0.70 0.60 1</ambient><diffuse>0.75 0.70 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DOCKING STATION -->
    <model name="docking_station">
      <static>true</static><pose>0 0 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>3.2 3.2 0.001</size></box></geometry>
          <material>
            <ambient>0.50 0.50 0.50 1</ambient>
            <diffuse>0.50 0.50 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="dock_cross_h">
      <static>true</static><pose>0 0 0.002 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><box><size>2.6 0.12 0.001</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual></link>
    </model>
    <model name="dock_cross_v">
      <static>true</static><pose>0 0 0.002 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><box><size>0.12 2.6 0.001</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual></link>
    </model>

    <!-- EAST – COMMERCIAL -->
    <include>
      <name>supermarket</name>
      <uri>model://supermarket</uri>
      <pose>8 3 0 0 0 0</pose>
    </include>
    <include>
      <name>restaurant</name>
      <uri>model://kyoto_restaurant</uri>
      <pose>14 -3 0 0 0 3.14159</pose>
    </include>

    <!-- WEST – SERVICE -->
    <include>
      <name>pharmacy</name>
      <uri>model://pharmacy</uri>
      <pose>-12 6 0 0 0 0</pose>
    </include>
    <include>
      <name>fire_station_2</name>
      <uri>model://fire_station_2</uri>
      <pose>-12 -6 0 0 0 0</pose>
    </include>

    <!-- NORTH RESIDENTIAL -->
    <include>
      <name>house_north_1</name>
      <uri>model://jap_home_1</uri>
      <pose>-6 13 0 0 0 0</pose>
    </include>
    <include>
      <name>house_north_2</name>
      <uri>model://jap_home_1</uri>
      <pose>-6 19 0 0 0 0</pose>
    </include>

    <!-- SOUTH RESIDENTIAL -->
    <include>
      <name>house_south_1</name>
      <uri>model://jap_home_3</uri>
      <pose>1 18 0 0 0 3.14159</pose>
    </include>
    <include>
      <name>house_south_2</name>
      <uri>model://jap_home_2</uri>
      <pose>-6 -14 0 0 0 0</pose>
    </include>
    <include>
      <name>house_south_3</name>
      <uri>model://jap_home_2</uri>
      <pose>6 -14 0 0 0 3.14159</pose>
    </include>

    <!-- STREET LAMPS -->
    <include>
      <name>lamp_plaza_ne</name>
      <uri>model://street_lamp</uri>
      <pose>3.5 3.5 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_plaza_sw</name>
      <uri>model://street_lamp</uri>
      <pose>-3.5 -3.5 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_east_st</name>
      <uri>model://street_lamp</uri>
      <pose>8 2 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_west_st</name>
      <uri>model://street_lamp</uri>
      <pose>-8 -2 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_north</name>
      <uri>model://street_lamp</uri>
      <pose>2.5 7 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_south</name>
      <uri>model://street_lamp</uri>
      <pose>-2.5 -7 0 0 0 0</pose>
    </include>

    <!-- BENCHES -->
    <include>
      <name>bench_plaza_1</name>
      <uri>model://bench</uri>
      <pose>2.2 1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>bench_plaza_2</name>
      <uri>model://bench</uri>
      <pose>-2.2 -1.5 0 0 0 3.14159</pose>
    </include>
    <include>
      <name>bench_garden_nw</name>
      <uri>model://bench</uri>
      <pose>-5.5 8.5 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>bench_garden_sw</name>
      <uri>model://bench</uri>
      <pose>-6 -7 0 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!--  TREES  (12 total)                                           -->
    <!--  4 at docking-station corners (just outside the 3.2x3.2 pad) -->
    <!--  8 spread across empty areas of the map                      -->
    <!-- ============================================================ -->

    <!-- Docking station corners -->
    <include>
      <name>tree_dock_ne</name>
      <uri>model://tree</uri>
      <pose>2.0 2.0 0 0 0 0</pose>
    </include>
    <include>
      <name>tree_dock_nw</name>
      <uri>model://tree</uri>
      <pose>-2.0 2.0 0 0 0 0</pose>
    </include>
    <include>
      <name>tree_dock_se</name>
      <uri>model://tree</uri>
      <pose>2.0 -2.0 0 0 0 0</pose>
    </include>
    <include>
      <name>tree_dock_sw</name>
      <uri>model://tree</uri>
      <pose>-2.0 -2.0 0 0 0 0</pose>
    </include>

    <!-- North open area (between plaza and north houses) -->
    <include>
      <name>tree_north_w</name>
      <uri>model://tree</uri>
      <pose>-3 8.5 0 0 0 0</pose>
    </include>
    <include>
      <name>tree_north_e</name>
      <uri>model://tree</uri>
      <pose>3 8.5 0 0 0 0</pose>
    </include>

    <!-- NW open area (between pharmacy and north houses) -->
    <include>
      <name>tree_nw</name>
      <uri>model://tree</uri>
      <pose>-7 9.5 0 0 0 0</pose>
    </include>

    <!-- SW open area (between fire station and south houses) -->
    <include>
      <name>tree_sw</name>
      <uri>model://tree</uri>
      <pose>-7 -8 0 0 0 0</pose>
    </include>

    <!-- South open area (between plaza and south houses) -->
    <include>
      <name>tree_south_w</name>
      <uri>model://tree</uri>
      <pose>-3 -8.5 0 0 0 0</pose>
    </include>
    <include>
      <name>tree_south_e</name>
      <uri>model://tree</uri>
      <pose>3 -8.5 0 0 0 0</pose>
    </include>

    <!-- East open gap between supermarket and restaurant -->
    <include>
      <name>tree_east_mid</name>
      <uri>model://tree</uri>
      <pose>6 0 0 0 0 0</pose>
    </include>
    <!-- East of south houses, open space -->
    <include>
      <name>tree_east_south</name>
      <uri>model://tree</uri>
      <pose>12 -11 0 0 0 0</pose>
    </include>


























    <!-- QR SIGNS -->
    <include>
      <name>sign_house_1</name>
      <uri>model://sign_house_1</uri>
      <pose>-2.5 13.0 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>sign_house_2</name>
      <uri>model://sign_house_2</uri>
      <pose>-2.5 19.0 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>sign_house_3</name>
      <uri>model://sign_house_3</uri>
      <pose>1.0 13.5 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>sign_house_4</name>
      <uri>model://sign_house_4</uri>
      <pose>-6.0 -11.0 0 0 0 3.14159</pose>
    </include>
    <include>
      <name>sign_house_5</name>
      <uri>model://sign_house_5</uri>
      <pose>6.0 -11.0 0 0 0 3.14159</pose>
    </include>
    <include>
      <name>sign_pharmacy</name>
      <uri>model://sign_pharmacy</uri>
      <pose>-12.0 1.5 0 0 0 0.0</pose>
    </include>
    <include>
      <name>sign_fire_station</name>
      <uri>model://sign_fire_station</uri>
      <pose>-12.0 -3.5 0 0 0 3.14159</pose>
    </include>
    <include>
      <name>sign_restaurant</name>
      <uri>model://sign_restaurant</uri>
      <pose>14.0 -11.5 0 0 0 3.14159</pose>
    </include>
    <include>
      <name>sign_supermarket</name>
      <uri>model://sign_supermarket</uri>
      <pose>12.5 1.0 0 0 0 0.0</pose>
    </include>
    <!-- END QR SIGNS -->

  </world>
</sdf>
