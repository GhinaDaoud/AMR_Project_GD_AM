<?xml version="1.0" ?>
<!-- Park bench: 1.2m wooden seat with backrest. Origin at ground level, seat faces -Y -->
<sdf version="1.6">
  <model name="bench">
    <static>true</static>
    <link name="link">

      <!-- Collision (full envelope) -->
      <collision name="col">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry><box><size>1.2 0.5 0.7</size></box></geometry>
      </collision>

      <!-- Seat surface -->
      <visual name="seat">
        <pose>0 0 0.44 0 0 0</pose>
        <geometry><box><size>1.2 0.42 0.06</size></box></geometry>
        <material>
          <ambient>0.48 0.30 0.08 1</ambient>
          <diffuse>0.48 0.30 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Backrest (slightly angled back) -->
      <visual name="backrest">
        <pose>0 0.17 0.62 0.20 0 0</pose>
        <geometry><box><size>1.2 0.07 0.36</size></box></geometry>
        <material>
          <ambient>0.48 0.30 0.08 1</ambient>
          <diffuse>0.48 0.30 0.08 1</diffuse>
        </material>
      </visual>

      <!-- Left leg -->
      <visual name="leg_left">
        <pose>-0.52 0 0.22 0 0 0</pose>
        <geometry><box><size>0.06 0.42 0.44</size></box></geometry>
        <material>
          <ambient>0.38 0.22 0.06 1</ambient>
          <diffuse>0.38 0.22 0.06 1</diffuse>
        </material>
      </visual>

      <!-- Right leg -->
      <visual name="leg_right">
        <pose>0.52 0 0.22 0 0 0</pose>
        <geometry><box><size>0.06 0.42 0.44</size></box></geometry>
        <material>
          <ambient>0.38 0.22 0.06 1</ambient>
          <diffuse>0.38 0.22 0.06 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
