<?xml version="1.0" ?>
<!--
  mini_mart / convenience store (e048ff GLB)
  GLB bounds: X=[-8.3, 15.2]  Y=[-2.1, 1.0]  Z=[-1.0, 1.0] — GLTF Y-up, units=metres
  At scale 1.0: footprint ≈ 23.5 x 2.1 m, height ≈ 3.1 m
  Correction: roll=+π/2 (Y-up → Z-up).  tz=2.1 lifts floor to Z=0 (min_Y=-2.1).
-->
<sdf version="1.6">
  <model name="mini_mart">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>3.45 0 1.55 0 0 0</pose>
        <geometry><box><size>23.5 2.1 3.1</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 2.1 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mini_mart/meshes/model.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
