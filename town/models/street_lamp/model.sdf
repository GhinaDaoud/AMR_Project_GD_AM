<?xml version="1.0" ?>
<!-- Street lamp: 4m dark metal pole with emissive yellow sphere head -->
<sdf version="1.6">
  <model name="street_lamp">
    <static>true</static>
    <link name="link">

      <!-- Pole collision -->
      <collision name="col_pole">
        <pose>0 0 2.0 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>4.0</length></cylinder></geometry>
      </collision>

      <!-- Base plate -->
      <visual name="base">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
        <material>
          <ambient>0.20 0.20 0.20 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Pole -->
      <visual name="pole">
        <pose>0 0 2.1 0 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>4.0</length></cylinder></geometry>
        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.22 0.22 0.22 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Arm bracket -->
      <visual name="arm">
        <pose>0.2 0 4.2 0 0 0</pose>
        <geometry><box><size>0.4 0.06 0.06</size></box></geometry>
        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.22 0.22 0.22 1</diffuse>
        </material>
      </visual>

      <!-- Lamp head (emissive sphere) -->
      <visual name="head">
        <pose>0 0 4.35 0 0 0</pose>
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material>
          <ambient>1.0 0.95 0.65 1</ambient>
          <diffuse>1.0 0.95 0.65 1</diffuse>
          <emissive>0.90 0.80 0.25 1</emissive>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>
