<?xml version="1.0" ?>
<!-- Restaurant: 7x6m commercial, warm beige walls, red awning. Front faces -Y (Y=-3.0) -->
<sdf version="1.6">
  <model name="restaurant">
    <static>true</static>
    <link name="link">

      <collision name="col">
        <pose>0 0 2.0 0 0 0</pose>
        <geometry><box><size>7 6 4.0</size></box></geometry>
      </collision>

      <visual name="walls">
        <pose>0 0 1.85 0 0 0</pose>
        <geometry><box><size>7 6 3.7</size></box></geometry>
        <material>
          <ambient>0.85 0.74 0.58 1</ambient>
          <diffuse>0.85 0.74 0.58 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Flat roof with slight overhang -->
      <visual name="roof">
        <pose>0 0 3.76 0 0 0</pose>
        <geometry><box><size>7.3 6.3 0.12</size></box></geometry>
        <material><ambient>0.55 0.45 0.32 1</ambient><diffuse>0.55 0.45 0.32 1</diffuse></material>
      </visual>

      <!-- Red awning (front at Y=-3.0) -->
      <visual name="awning">
        <pose>0 -3.4 2.9 0.25 0 0</pose>
        <geometry><box><size>6.5 0.9 0.1</size></box></geometry>
        <material><ambient>0.78 0.12 0.10 1</ambient><diffuse>0.78 0.12 0.10 1</diffuse></material>
      </visual>
      <visual name="awning_bar">
        <pose>0 -3.35 2.75 0 0 0</pose>
        <geometry><box><size>6.5 0.06 0.06</size></box></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>

      <!-- Large front windows -->
      <visual name="win_front_left">
        <pose>-2.0 -3.06 2.0 0 0 0</pose>
        <geometry><box><size>1.8 0.1 2.0</size></box></geometry>
        <material>
          <ambient>0.75 0.88 1.0 1</ambient><diffuse>0.75 0.88 1.0 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="win_front_right">
        <pose>2.0 -3.06 2.0 0 0 0</pose>
        <geometry><box><size>1.8 0.1 2.0</size></box></geometry>
        <material>
          <ambient>0.75 0.88 1.0 1</ambient><diffuse>0.75 0.88 1.0 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>

      <visual name="door">
        <pose>0 -3.06 0.95 0 0 0</pose>
        <geometry><box><size>1.0 0.12 2.0</size></box></geometry>
        <material><ambient>0.60 0.38 0.18 1</ambient><diffuse>0.60 0.38 0.18 1</diffuse></material>
      </visual>

      <visual name="win_side">
        <pose>3.56 0 2.2 0 0 0</pose>
        <geometry><box><size>0.1 1.4 1.1</size></box></geometry>
        <material>
          <ambient>0.75 0.88 1.0 1</ambient><diffuse>0.75 0.88 1.0 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>

      <visual name="qr_code">
        <pose>-2.8 -3.035 2.0 0 0 0</pose>
        <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

    </link>
  </model>
</sdf>
