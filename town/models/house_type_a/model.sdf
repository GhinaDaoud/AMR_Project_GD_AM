<?xml version="1.0" ?>
<!-- House Type A: 6x6m brown residential, pitched terracotta roof, front faces -Y -->
<sdf version="1.6">
  <model name="house_type_a">
    <static>true</static>
    <link name="link">

      <collision name="col">
        <pose>0 0 2.25 0 0 0</pose>
        <geometry><box><size>6 6 4.5</size></box></geometry>
      </collision>

      <!-- Main walls 6x6x3.8m -->
      <visual name="walls">
        <pose>0 0 1.9 0 0 0</pose>
        <geometry><box><size>6 6 3.8</size></box></geometry>
        <material>
          <ambient>0.72 0.58 0.38 1</ambient>
          <diffuse>0.72 0.58 0.38 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Roof: angle = atan(1/3) = 0.322 rad; center Y=±1.5, Z=4.1 -->
      <visual name="roof_left">
        <pose>0 1.5 4.1 -0.322 0 0</pose>
        <geometry><box><size>6.2 3.4 0.18</size></box></geometry>
        <material>
          <ambient>0.52 0.20 0.10 1</ambient>
          <diffuse>0.52 0.20 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="roof_right">
        <pose>0 -1.5 4.1 0.322 0 0</pose>
        <geometry><box><size>6.2 3.4 0.18</size></box></geometry>
        <material>
          <ambient>0.52 0.20 0.10 1</ambient>
          <diffuse>0.52 0.20 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="ridge">
        <pose>0 0 4.62 0 0 0</pose>
        <geometry><box><size>6.2 0.32 0.14</size></box></geometry>
        <material>
          <ambient>0.35 0.13 0.06 1</ambient>
          <diffuse>0.35 0.13 0.06 1</diffuse>
        </material>
      </visual>

      <!-- Door on front (-Y) face; face is at Y=-3.0 -->
      <visual name="door">
        <pose>0 -3.06 1.0 0 0 0</pose>
        <geometry><box><size>0.9 0.12 2.0</size></box></geometry>
        <material>
          <ambient>0.35 0.20 0.08 1</ambient>
          <diffuse>0.35 0.20 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="door_frame">
        <pose>0 -3.045 1.05 0 0 0</pose>
        <geometry><box><size>1.1 0.09 2.2</size></box></geometry>
        <material>
          <ambient>0.86 0.80 0.70 1</ambient>
          <diffuse>0.86 0.80 0.70 1</diffuse>
        </material>
      </visual>

      <visual name="win_front_left">
        <pose>-1.8 -3.06 2.3 0 0 0</pose>
        <geometry><box><size>0.9 0.1 0.8</size></box></geometry>
        <material>
          <ambient>0.78 0.88 1.0 1</ambient><diffuse>0.78 0.88 1.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <visual name="win_front_right">
        <pose>1.8 -3.06 2.3 0 0 0</pose>
        <geometry><box><size>0.9 0.1 0.8</size></box></geometry>
        <material>
          <ambient>0.78 0.88 1.0 1</ambient><diffuse>0.78 0.88 1.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <visual name="win_side">
        <pose>3.06 0 2.3 0 0 0</pose>
        <geometry><box><size>0.1 0.9 0.8</size></box></geometry>
        <material>
          <ambient>0.78 0.88 1.0 1</ambient><diffuse>0.78 0.88 1.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- QR placeholder: 0.5x0.5m white panel on front wall at 2m height -->
      <visual name="qr_code">
        <pose>0 -3.035 2.0 0 0 0</pose>
        <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

    </link>
  </model>
</sdf>
