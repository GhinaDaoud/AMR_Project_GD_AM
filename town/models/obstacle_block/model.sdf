<?xml version="1.0" ?>
<!-- Obstacle block: 3x3x2m grey concrete barrier (navigation challenge, v1.2 element) -->
<sdf version="1.6">
  <model name="obstacle_block">
    <static>true</static>
    <link name="link">
      <collision name="col">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry><box><size>3 3 2</size></box></geometry>
      </collision>
      <visual name="vis">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry><box><size>3 3 2</size></box></geometry>
        <material>
          <ambient>0.50 0.50 0.50 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Hazard stripe on top -->
      <visual name="stripe">
        <pose>0 0 2.01 0 0 0</pose>
        <geometry><box><size>3 3 0.02</size></box></geometry>
        <material>
          <ambient>0.85 0.65 0.05 1</ambient>
          <diffuse>0.85 0.65 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
