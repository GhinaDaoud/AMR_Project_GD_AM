    </model>

    <!-- ===== QR LANDMARK: tl_box at (-7.5, 6) QR facing south ===== -->
    <model name="tl_box">
      <static>true</static>
      <link name="link">
        <pose>-7.5 6 0.75 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>1.5 1.5 1.5</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>1.5 1.5 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <!--
          QR: half size (0.7×0.7), bottom-right of south face.
          World z-centre = 0.75 + (-0.40) = 0.35 m — near camera height.
        -->
        <visual name="qr_face">
          <pose>0.40 -0.76 -0.40 0 0 0</pose>
          <geometry><box><size>0.7 0.01 0.7</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/test/AMR_project/src/robot_description/worlds/qr_textures/qr_tl_box.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== QR LANDMARK: pillar_a at (0, 3) QR facing west ===== -->
    <model name="pillar_a">
      <static>true</static>
      <link name="link">
        <pose>0 3 1 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>1.5 1.5 2</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>1.5 1.5 2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <!--
          QR: half size (0.7×0.7), bottom-right of west face.
          World z-centre = 1 + (-0.65) = 0.35 m.
          y offset = -0.40 puts it to the right when robot looks west.
        -->
        <visual name="qr_face">
          <pose>-0.76 -0.40 -0.65 0 0 0</pose>
          <geometry><box><size>0.01 0.7 0.7</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/test/AMR_project/src/robot_description/worlds/qr_textures/qr_pillar_a.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== QR LANDMARK: pillar_b at (0, -4) QR facing west ===== -->
    <model name="pillar_b">
      <static>true</static>
      <link name="link">
        <pose>0 -4 1 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>1.5 1.5 2</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>1.5 1.5 2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <visual name="qr_face">
          <pose>-0.76 -0.40 -0.65 0 0 0</pose>
          <geometry><box><size>0.01 0.7 0.7</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/test/AMR_project/src/robot_description/worlds/qr_textures/qr_pillar_b.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== QR LANDMARK: diag_block_1 at (6,6) QR on inward face ===== -->
    <model name="diag_block_1">
      <static>true</static>
      <link name="link">
        <pose>6 6 1 0 0 0.785</pose>
        <collision name="c">
          <geometry><box><size>3 0.3 2</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>3 0.3 2</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <!--
          QR: half W (1.45) × half H (0.7), bottom-centre of inward face.
          World z-centre = 1 + (-0.65) = 0.35 m.
        -->
        <visual name="qr_face">
          <pose>0 0.16 -0.65 0 0 0</pose>
          <geometry><box><size>1.45 0.01 0.7</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/test/AMR_project/src/robot_description/worlds/qr_textures/qr_diag_block_1.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="diag_block_2">
