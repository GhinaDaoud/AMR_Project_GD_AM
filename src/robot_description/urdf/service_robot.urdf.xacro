<?xml version="1.0"?>
<robot name="service_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robot_description)/urdf/gazebo_plugins.xacro"/>

  <!-- ===================== PROPERTIES ===================== -->
  <!--
    Layout inspired by the Gazebo tutorial car:
      - Chassis elevated so its bottom is at wheel-axle height
      - Drive wheels mounted at the REAR of the chassis
      - Front ball-caster provides the third contact point
  -->
  <xacro:property name="base_length"   value="0.45"/>
  <xacro:property name="base_width"    value="0.30"/>
  <xacro:property name="base_height"   value="0.15"/>
  <xacro:property name="wheel_radius"  value="0.07"/>
  <xacro:property name="wheel_width"   value="0.05"/>
  <xacro:property name="caster_radius" value="0.035"/>   <!-- wheel_radius / 2 -->
  <!-- drive wheels are offset 12 cm toward the rear of the chassis -->
  <xacro:property name="wheel_x"       value="-0.12"/>
  <!-- derived: wheel separation = base_width + wheel_width -->
  <xacro:property name="wheel_sep"     value="${base_width + wheel_width}"/>  <!-- 0.35 m -->

  <!-- ===================== BASE FOOTPRINT ===================== -->
  <link name="base_footprint"/>

  <!--
    Chassis centre must sit at  wheel_radius + base_height/2  above base_footprint
    so that the chassis bottom is flush with the drive-wheel axle plane and the
    wheels just touch the ground (z = 0).
      wheel_radius=0.07, base_height/2=0.075  →  joint z = 0.145
  -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== CHASSIS (base_link) ===================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <!-- box inertia: Ixx = m(w²+h²)/12, etc. -->
      <inertia
        ixx="${5.0*(base_width*base_width + base_height*base_height)/12.0}"
        ixy="0" ixz="0"
        iyy="${5.0*(base_length*base_length + base_height*base_height)/12.0}"
        iyz="0"
        izz="${5.0*(base_length*base_length + base_width*base_width)/12.0}"/>
    </inertial>
  </link>

  <!-- ===================== LEFT WHEEL (rear) ===================== -->
  <!--
    Joint z = -base_height/2  →  wheel centre in world = 0.145 - 0.075 = 0.07 = wheel_radius ✓
  -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_x} ${base_width/2 + wheel_width/2} ${-base_height/2}"
            rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <!-- cylinder: Ixx=Iyy = m(3r²+h²)/12, Izz = mr²/2 -->
      <inertia
        ixx="${0.8*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12.0}"
        ixy="0" ixz="0"
        iyy="${0.8*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12.0}"
        iyz="0"
        izz="${0.8*wheel_radius*wheel_radius/2.0}"/>
    </inertial>
  </link>

  <!-- ===================== RIGHT WHEEL (rear) ===================== -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_x} ${-(base_width/2 + wheel_width/2)} ${-base_height/2}"
            rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia
        ixx="${0.8*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12.0}"
        ixy="0" ixz="0"
        iyy="${0.8*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12.0}"
        iyz="0"
        izz="${0.8*wheel_radius*wheel_radius/2.0}"/>
    </inertial>
  </link>

  <!-- ===================== FRONT CASTER ===================== -->
  <!--
    Caster sphere radius = wheel_radius/2 = 0.035.
    Its centre must be at z = caster_radius above base_footprint.
    Joint z (relative to base_link at 0.145) = caster_radius - (wheel_radius+base_height/2)
             = 0.035 - 0.145 = -0.110
    Equivalently: -(base_height/2 + wheel_radius/2) = -(0.075+0.035) = -0.110 ✓
  -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${base_length/2 - 0.06} 0 ${-(base_height/2 + caster_radius)}" rpy="0 0 0"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 0.8 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <!-- sphere: I = 2mr²/5 -->
      <inertia
        ixx="${2*0.2*caster_radius*caster_radius/5.0}"
        ixy="0" ixz="0"
        iyy="${2*0.2*caster_radius*caster_radius/5.0}"
        iyz="0"
        izz="${2*0.2*caster_radius*caster_radius/5.0}"/>
    </inertial>
  </link>

  <!-- ===================== LIDAR ===================== -->
  <!-- Sits on the chassis top, slightly toward the rear so the camera has a clear view ahead -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.05 0 ${base_height/2 + 0.025}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ===================== CAMERA (front face) ===================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.04"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ===================== IMU ===================== -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

</robot>
